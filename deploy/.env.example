# Image to run (pin a version in production).
KANZO_IMAGE=ghcr.io/mateuszklysz/kanzo:0.4.1
# Use ghcr.io/mateuszklysz/kanzo:0.4.1-git for `kanzo sync` support.

# Public DNS name pointing at this server (A/AAAA record).
KANZO_DOMAIN=kanzo.example.com

# Basic auth in front of the board and /mcp.
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
KANZO_AUTH_USER=admin
KANZO_AUTH_HASH='$2a$14$replace.me.with.the.output.of.caddy.hash-password.....'

# Optional, -git image only: token for `kanzo sync` with a private HTTPS repo.
KANZO_GIT_TOKEN=
