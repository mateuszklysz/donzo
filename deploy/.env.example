# Image to run (pin a version in production).
KANZO_IMAGE=ghcr.io/mateuszklysz/kanzo:0.4.1
# Use ghcr.io/mateuszklysz/kanzo:0.4.1-git for `kanzo sync` support.

# Public DNS name pointing at this server (A/AAAA record).
KANZO_DOMAIN=kanzo.example.com

# HTTPS certificate. Default: Caddy gets one from Let's Encrypt (ports 80 and 443).
# If the domain already has a certificate, pick one (COMPOSE_FILE is a :-separated list,
# combine with compose.sso.yaml as needed):
#  - your own certificate files (certs/fullchain.pem, certs/privkey.pem):
#COMPOSE_FILE=compose.yaml:compose.tls-files.yaml
#KANZO_CERTS_DIR=./certs
#  - another reverse proxy (nginx, Traefik, ...) already does HTTPS on this server:
#COMPOSE_FILE=compose.yaml:compose.behind-proxy.yaml
#KANZO_HTTP_BIND=127.0.0.1
#KANZO_HTTP_PORT=8080

# Basic auth: for the whole board, or with GitHub sign-in only for /mcp (agents).
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
KANZO_AUTH_USER=admin
KANZO_AUTH_HASH='$2a$14$replace.me.with.the.output.of.caddy.hash-password.....'

# --- GitHub sign-in (optional, recommended) ---------------------------------
# Uncomment to sign in to the board with GitHub instead of the password.
#COMPOSE_FILE=compose.yaml:compose.sso.yaml
# GitHub OAuth app (Settings > Developer settings > OAuth Apps), callback URL:
# https://<KANZO_DOMAIN>/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random secret for the session cookie: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
# Who may sign in: GitHub logins, comma-separated (required).
GITHUB_USERS=
# Optional: also let in all members of this org, or of these teams (org:team,...).
GITHUB_ORG=
GITHUB_TEAM=

# Optional, -git image only: token for `kanzo sync` with a private HTTPS repo.
KANZO_GIT_TOKEN=
