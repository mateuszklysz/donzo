[Unit]
Description=OAuth2 Proxy for Kanzo (GitHub SSO)
Documentation=https://oauth2-proxy.github.io/oauth2-proxy/
After=network-online.target kanzo.service
Requires=kanzo.service
Wants=network-online.target

[Container]
ContainerName=kanzo-proxy
Image=quay.io/oauth2-proxy/oauth2-proxy:v7.15.5@sha256:8498b0d0ef0a7b29686414000a08aee467f02d0299c9ed1e006a8f33fc017916
Network=kanzo.network
EnvironmentFile=kanzo.env
Environment=OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
Environment=OAUTH2_PROXY_UPSTREAMS=http://kanzo:4242/
Environment=OAUTH2_PROXY_REVERSE_PROXY=true
Environment=OAUTH2_PROXY_PASS_HOST_HEADER=true
Environment=OAUTH2_PROXY_EMAIL_DOMAINS=*
Environment=OAUTH2_PROXY_PROVIDER=github
Environment=OAUTH2_PROXY_COOKIE_SECURE=true
Environment=OAUTH2_PROXY_COOKIE_SAMESITE=lax
Environment=OAUTH2_PROXY_COOKIE_NAME=__Host-kanzo_session
Environment=OAUTH2_PROXY_COOKIE_EXPIRE=24h
Environment=OAUTH2_PROXY_COOKIE_REFRESH=1h
Environment=OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
Environment=OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m
Environment=OAUTH2_PROXY_FOOTER=-
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
