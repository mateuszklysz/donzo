# GitHub OAuth application credentials
# Note: For organization or team access, use a GitHub OAuth App (not a GitHub App)
# with the scope 'user:email read:org' so private memberships are visible.
OAUTH2_PROXY_CLIENT_ID=your_github_client_id
OAUTH2_PROXY_CLIENT_SECRET=your_github_client_secret

# Session cookie encryption key (generate with: openssl rand -base64 32 | tr -- '+/' '-_')
OAUTH2_PROXY_COOKIE_SECRET=your_32_byte_cookie_secret

# Access control: allow members of an organization:
OAUTH2_PROXY_SCOPE=user:email read:org
OAUTH2_PROXY_GITHUB_ORG=your-github-org

# Or allow specific users (comma-separated; comment out OAUTH2_PROXY_GITHUB_ORG):
# OAUTH2_PROXY_SCOPE=user:email
# OAUTH2_PROXY_GITHUB_USERS=user1,user2
